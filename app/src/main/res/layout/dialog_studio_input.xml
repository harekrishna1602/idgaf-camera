<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_pill"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtStudioInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="INPUT"
        android:textColor="#FF5F1F"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStudioInputMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text=""
        android:textColor="#B0B7C3"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edtStudioInput"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_dock_pill_active"
        android:fontFamily="monospace"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#66FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStudioInputCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="CANCEL"
            android:textColor="#B0B7C3"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStudioInputNeutral"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="ALT"
            android:textColor="#FF5F1F"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStudioInputPositive"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lens_active"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="SAVE"
            android:textColor="#0B0D10"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
