<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hud_pill"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtStudioPromptTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="TITLE"
        android:textColor="#FF5F1F"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStudioPromptMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text=""
        android:textColor="#E5E7EB"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStudioPromptCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="CANCEL"
            android:textColor="#B0B7C3"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStudioPromptNeutral"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="ALT"
            android:textColor="#FF5F1F"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStudioPromptPositive"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_lens_active"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="OK"
            android:textColor="#0B0D10"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
