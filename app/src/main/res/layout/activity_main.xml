<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-Bleed Native Camera2 Viewfinder -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Phase 3: Cinema Monitoring Overlays (Peaking, Zebras, Guides, Grid, Histogram) -->
    <com.studiomogli.idgafcamera.CinemaOverlayView
        android:id="@+id/cinemaOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Self-Timer Countdown Overlay -->
    <TextView
        android:id="@+id/txtTimerCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="monospace"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="12"
        android:text="3"
        android:textColor="#FF5F1F"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Tap-to-Focus Reticle -->
    <View
        android:id="@+id/focusReticle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_focus_reticle"
        android:visibility="gone" />

    <!-- TOP CINEMA TELEMETRY BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="top"
        android:background="#990B0D10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/btnBrandCredits"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:paddingEnd="8dp"
            android:text="IDGAF CAM"
            android:textColor="#FF5F1F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Live Audio VU Meter + dB Badge (Tap to open Pro Audio Controller) -->
        <LinearLayout
            android:id="@+id/btnAudioPanelToggle"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="7dp">

            <com.studiomogli.idgafcamera.AudioMeterView
                android:id="@+id/audioMeterView"
                android:layout_width="68dp"
                android:layout_height="11dp" />

            <TextView
                android:id="@+id/txtAudioDb"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:singleLine="true"
                android:text="-∞"
                android:textColor="#34C759"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Battery % & Free Storage (GB) -->
        <TextView
            android:id="@+id/txtSysTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="monospace"
            android:text="100% • 0GB"
            android:textColor="#B0B7C3"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Live Recording Dot + Timecode -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/viewRecDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_shutter_rec"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtTimecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnUpdateApp"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_lens_active"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="UPDATE"
            android:textColor="#0B0D10"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnProSettingsToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="PRO"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMonitorToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="MON"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnResolution"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="1080P"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFps"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="30 FPS"
            android:textColor="#FF5F1F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FLOATING MONITORING TOOLS BAR (Toggled by MON pill) -->
    <LinearLayout
        android:id="@+id/monitorToolsBar"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnToolGrid"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="GRID"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToolFrame"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="FRAME: OFF"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToolPeak"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="PEAK"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToolZebra"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="ZEBRA"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToolHist"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="HIST"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnToolHorizon"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="LEVEL"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FLOATING PRO AUDIO / CODEC / BITRATE BAR (Toggled by PRO pill) -->
    <LinearLayout
        android:id="@+id/proSettingsBar"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnProCodec"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="H.264"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProBitrate"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="35 Mbps"
            android:textColor="#FF5F1F"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProMic"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="MIC: AUTO"
            android:textColor="#34C759"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProTone"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="STD"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProStab"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_lens_active"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="STAB"
            android:textColor="#0B0D10"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProTorch"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="TORCH"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProTimer"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="TMR: OFF"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnProPresets"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="PRESETS"
            android:textColor="#FF5F1F"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FLOATING PRO AUDIO CONTROLLER DRAWER (Opened by tapping VU Meter) -->
    <LinearLayout
        android:id="@+id/audioControlDrawer"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_hud_pill"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="PRO AUDIO • 48kHz AAC"
                android:textColor="#FF5F1F"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudioMute"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="LIVE"
                android:textColor="#34C759"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hardware Preamp Stage + Mic Routing -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="monospace"
                android:text="STAGE"
                android:textColor="#8E96A4"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreampCam"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_lens_active"
                android:gravity="center"
                android:text="CAM"
                android:textColor="#0B0D10"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreampRaw"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="RAW"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPreampBoost"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="BOOST"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Input Trim / Monitor Gain Slider (-12 dB to +12 dB) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="VU TRIM"
                android:textColor="#8E96A4"
                android:textSize="9sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/audioGainSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="24"
                android:progress="12"
                android:progressTint="#FF5F1F"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/txtAudioTrimVal"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="0 dB"
                android:textColor="#FF5F1F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- LEFT RAIL: DYNAMIC LENS SWITCHER -->
    <LinearLayout
        android:id="@+id/lensRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical" />

    <!-- FLOATING ZOOM ENGINE v2 POPOUT DRAWER (Presets, Curves, A/B Smooth Pull + Slider) -->
    <LinearLayout
        android:id="@+id/zoomPopoutDrawer"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="156dp"
        android:background="@drawable/bg_hud_pill"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Row 1: Smooth Preset Zooms (1x / 2x / 5x / MAX) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnZoomPreset1x"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_lens_active"
                android:gravity="center"
                android:text="1x"
                android:textColor="#0B0D10"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoomPreset2x"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="2x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoomPreset5x"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="5x"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoomPresetMax"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="MAX"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 2: Zoom Curve (LIN / EXP / CRASH) + Smooth Pull Duration + A/B Zoom Pull -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnZoomCurve"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_lens_active"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="EXP"
                android:textColor="#0B0D10"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoomTime"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="1.5s"
                android:textColor="#CCCCCC"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSetZoomA"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSetZoomB"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="B"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPullZoomAB"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="A→B"
                android:textColor="#FF5F1F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Row 3: Compact Direct Zoom Slider -->
        <SeekBar
            android:id="@+id/zoomSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressTint="#FF5F1F"
            android:thumbTint="#FFFFFF" />
    </LinearLayout>

    <!-- SLEEK PRO ZOOM ROCKER (T / 1.0x / W + Speed) -->
    <LinearLayout
        android:id="@+id/zoomRockerContainer"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="104dp"
        android:background="@drawable/bg_hud_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnZoomTele"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:text="T"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtZoomReadout"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#FF5F1F"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnZoomWide"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:text="W"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnZoomSpeed"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="MED"
            android:textColor="#8E96A4"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- RIGHT RAIL: TACTILE REC SHUTTER + CLIP GALLERY -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btnShutterOuter"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_shutter_ring">

            <View
                android:id="@+id/btnShutterInner"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_rec" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnLastClip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="CLIPS"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BOTTOM PRO CINEMA CONTROL DOCK + FLOATING SLIDER DRAWER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="80dp"
        android:paddingEnd="160dp"
        android:paddingBottom="10dp">

        <!-- Floating Tactile Pro Slider Drawer -->
        <LinearLayout
            android:id="@+id/sliderDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_hud_pill"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtSliderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ISO"
                    android:textColor="#8E96A4"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSliderReadout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="AUTO"
                    android:textColor="#FF5F1F"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Shutter Unit Toggle (Speed 1/X vs Angle DEG) -->
                <TextView
                    android:id="@+id/btnShutterUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_hud_pill"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="SPD"
                    android:textColor="#FF5F1F"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 180-Degree Shutter Rule Lock (Shutter Panel Only) -->
                <TextView
                    android:id="@+id/btnSlider180"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_hud_pill"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="180°"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- A/B Rack Focus Buttons (Focus Panel Only) -->
                <LinearLayout
                    android:id="@+id/rackFocusRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnSetFocusA"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="SET A"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSetFocusB"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="SET B"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPullTime"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="1.2s"
                        android:textColor="#CCCCCC"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPullFocusAB"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_hud_pill"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="PULL A→B"
                        android:textColor="#FF5F1F"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSliderAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_lens_active"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="AUTO"
                    android:textColor="#0B0D10"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/proSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressTint="#FF5F1F"
                android:thumbTint="#FFFFFF" />

            <!-- White Balance Green / Magenta Tint Trim (Shown only in WB Panel) -->
            <LinearLayout
                android:id="@+id/wbTintRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="TINT"
                    android:textColor="#8E96A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/wbTintSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#E879F9"
                    android:thumbTint="#FFFFFF" />

                <TextView
                    android:id="@+id/txtWbTintVal"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Telemetry Control Dock (Blackmagic / RED Inspired) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- EV Pill -->
            <LinearLayout
                android:id="@+id/pillEv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EV"
                    android:textColor="#8E96A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtEvVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0.0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ISO Pill -->
            <LinearLayout
                android:id="@+id/pillIso"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISO"
                    android:textColor="#8E96A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIsoVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="AUTO"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SHUTTER Pill -->
            <LinearLayout
                android:id="@+id/pillShutter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHUTTER"
                    android:textColor="#8E96A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtShutterVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="1/60"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- WB Pill -->
            <LinearLayout
                android:id="@+id/pillWb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WB"
                    android:textColor="#8E96A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtWbVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="AWB"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- FOCUS Pill -->
            <LinearLayout
                android:id="@+id/pillFocus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUS"
                    android:textColor="#8E96A4"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFocusVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="AF-C"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- AE/AF LOCK Button -->
            <TextView
                android:id="@+id/btnAeAfLock"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_hud_pill"
                android:gravity="center"
                android:text="LOCK"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
