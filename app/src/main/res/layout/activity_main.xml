<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-Bleed Native Camera2 Viewfinder -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Tap-to-Focus Reticle -->
    <View
        android:id="@+id/focusReticle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_focus_reticle"
        android:visibility="gone" />

    <!-- TOP CINEMA TELEMETRY BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:background="#990B0D10"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IDGAF CAM"
            android:textColor="#FF5F1F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Live Recording Dot + Timecode -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <View
                android:id="@+id/viewRecDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_shutter_rec"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtTimecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnResolution"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="1080P"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFps"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="30 FPS"
            android:textColor="#FF5F1F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LEFT RAIL: DYNAMIC LENS SWITCHER -->
    <LinearLayout
        android:id="@+id/lensRail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical" />

    <!-- RIGHT RAIL: TACTILE REC SHUTTER + LAST CLIP -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btnShutterOuter"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_shutter_ring">

            <View
                android:id="@+id/btnShutterInner"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter_rec" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnLastClip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hud_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="CLIP"
            android:textColor="#CCCCCC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BOTTOM TELEMETRY STRIP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_gravity="bottom"
        android:background="#880B0D10"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/txtBottomTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="CAMERA2 ENGINE  •  INITIALIZING..."
            android:textColor="#B0B7C3"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>
